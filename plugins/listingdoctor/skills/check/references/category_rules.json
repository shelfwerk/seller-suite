  "patterns": [
   {
    "id": "CB6-eu-spf-over-50",
    "rules": [
     "CB6"
    ],
    "severity": "error",
    "markets": [
     "EU"
    ],
    "regex": "\\b(?:spf|lsf|lichtschutzfaktor)\\s*(?:5[1-9]|[6-9]\\d|[1-9]\\d{2})\\b",
    "message": "EU: highest labelled value is 'LSF/SPF 50+'",
    "message_de": "EU: höchster zulässiger Wert ist „LSF 50+“"
   },
   {
    "id": "CB6-us-water-resistant-time",
    "rules": [
     "CB6"
    ],
    "severity": "warning",
    "markets": [
     "US"
    ],
    "regex": "\\bwater[- ]?resistant\\b(?!\\s*\\(?\\s*(?:40|80)\\s*min)",
    "only_if_conditional": "CB6-sunscreen",
    "message": "US: only 'Water Resistant (40 minutes)' or '(80 minutes)'",
    "message_de": "US: nur „Water Resistant (40 minutes)“ oder „(80 minutes)“ erlaubt"
   },
   {
    "id": "CB10-hydroquinone",
    "rules": [
     "CB10",
     "CB1"
    ],
    "severity": "error",
    "markets": [
     "US",
     "EU"
    ],
    "regex": "\\bhydro(?:quinone|chinon)\\b(?![\\s-]*(?:free|frei))",
    "message": "Hydroquinone: unapproved OTC drug (US), banned in EU cosmetics; Amazon requires adulterant testing for lighteners",
    "message_de": "Hydrochinon: in EU-Kosmetik verboten, in den USA nicht zugelassenes OTC-Arzneimittel; Amazon verlangt Prüfberichte für Aufheller"
   },
   {
    "id": "CB7-inci-missing",
    "rules": [
     "CB7"
    ],
    "severity": "info",
    "markets": [
     "EU"
    ],
    "regex": ".",
    "requires_missing": "\\binci\\b|inhaltsstoffe|ingredients|\\baqua\\b|\\bglycerin\\b",
    "also_ok_if_attribute_filled": [
     "ingredients"
    ],
    "message": "No INCI ingredient list in the text – EU cosmetics need the full list in the offer (attribute or image is fine)",
    "message_de": "Keine INCI-Liste im Text – EU-Kosmetik braucht die vollständige Inhaltsstoffliste im Angebot (Attribut oder Bild genügt)"
   }
  ],
  "required_info_hint": "DE/EU: full INCI ingredient list in the offer (CB7); responsible person + manufacturer contact (GPSR G1); sunscreen: SPF category 6–50+ and UVA logo (CB6). US: SPF, acne, dandruff or antiperspirant claims make the product an OTC drug – Drug Facts image required (CB5/CB6); 'organic' needs USDA certificate naming the certifier (CB8); skin lighteners need third-party test documents in Manage your compliance (CB10).",
  "required_info_hint_de": "DE/EU: vollständige INCI-Liste im Angebot (CB7); verantwortliche Person + Herstellerkontakt (GPSR G1); Sonnenschutz: LSF-Kategorie 6–50+ und UVA-Logo (CB6). US: SPF-, Akne-, Schuppen- oder Antitranspirant-Aussagen machen das Produkt zum OTC-Arzneimittel – Drug-Facts-Bild nötig; 'organic' nur mit USDA-Zertifikat; Aufheller nur mit Prüfdokumenten."
 },
