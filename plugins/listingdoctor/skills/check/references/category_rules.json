  "patterns": [
   {
    "id": "CE9-powerbank-wh",
    "rules": [
     "CE9"
    ],
    "severity": "info",
    "markets": [
     "US",
     "EU"
    ],
    "if_regex": "\\b(?:power ?bank|akku-?pack|externer akku)\\b",
    "regex": "\\b\\d{3,6}\\s?mah\\b",
    "requires_missing": "\\b\\d+(?:[.,]\\d+)?\\s?wh\\b",
    "message": "Power bank: state rated capacity in mAh and Wh (> 100 Wh = dangerous goods review)",
    "message_de": "Powerbank: Nennkapazität in mAh und Wh angeben (> 100 Wh = Gefahrgutprüfung)"
   },
   {
    "id": "CE9-powerbank-implausible",
    "rules": [
     "CE9"
    ],
    "severity": "info",
    "markets": [
     "US",
     "EU"
    ],
    "if_regex": "\\b(?:power ?bank|akku-?pack)\\b",
    "regex": "\\b(?:[5-9]\\d{4}|\\d{6})\\s?mah\\b",
    "message": "≥ 50,000 mAh – check that the capacity claim is realistic and substantiated",
    "message_de": "≥ 50.000 mAh – prüfen, ob die Kapazitätsangabe realistisch und belegt ist"
   },
   {
    "id": "CE3-weee-number-format",
    "rules": [
     "CE3"
    ],
    "severity": "info",
    "markets": [
     "EU"
    ],
    "regex": "\\bweee[- ]?reg\\.?[- ]?nr\\.?\\s*:?\\s*(?!DE\\s?\\d{8}\\b)\\S+",
    "message": "WEEE-Reg.-Nr. format is 'DE' + 8 digits",
    "message_de": "WEEE-Reg.-Nr. hat das Format „DE“ + 8 Ziffern"
   }
  ],
  "required_info_hint": "amazon.de: producer's WEEE registration number (DE + 8 digits) in Amazon's EPR compliance section, offers of unregistered producers are blocked (CE3); batteries or devices with batteries: registered producer + take-back notice with crossed-out wheelie bin (CE4); energy-labelled groups incl. smartphones/tablets: EPREL no., efficiency class, label image + product information sheet (CE5); phones, tablets, headphones, speakers, keyboards, mice, cameras, consoles, laptops: common-charger pictogram + power label next to the price (CE6); accessories: '[own brand] [product] für/for [Brand Model]' (CE1).",
  "required_info_hint_de": "amazon.de: WEEE-Reg.-Nr. des Herstellers (DE + 8 Ziffern) im EPR-Bereich (CE3); Batterien/Geräte mit Batterie: registrierter Hersteller + Rücknahmehinweis mit Mülltonnensymbol (CE4); energielabelpflichtige Gruppen inkl. Smartphones/Tablets: EPREL-Nr., Klasse, Label-Bild + Datenblatt (CE5); Handys, Tablets, Kopfhörer, Lautsprecher, Tastaturen, Mäuse, Kameras, Konsolen, Laptops: Ladegerät-Piktogramm + Leistungsetikett beim Preis (CE6); Zubehör: '[eigene Marke] [Produkt] für [Marke Modell]' (CE1)."
 },
